# Dependencies
node_modules/

# Build output
dist/
coverage/

# Environment — secrets live here and are never committed
.env
.env.*
!.env.example

# Persistent data — the directory is a boundary (contracts §1); the folder is
# committed empty via .gitkeep and none of its runtime contents are ever tracked
data/*
!data/.gitkeep

# Project specification and phase prompts. These drive the build but are not
# part of the deliverable and must never be published with it.
.Phases/
phases/

# Local tool, editor, and workspace configuration — machine-specific
.claude/
.vscode/
.idea/
*.code-workspace

# Test and automation artifacts
test-results/
playwright-report/
blob-report/
.playwright/
*.tmp

# OS / logs
.DS_Store
Thumbs.db
*.log

# Vite dependency cache, rebuilt on every dev start.
.vite/
