# Copy to `.env` for local overrides. Every variable has a safe default, so an
# empty file works. `.env` is git-ignored and must never be committed.

# Runtime mode: development | test | production
NODE_ENV=development

# API server port. 0 asks the OS for a free port.
# Note: under `npm run dev`, PORT is the *client* port and the API uses API_PORT
# below, so the two dev processes never collide.
PORT=3001

# Dev only: API port used by `npm run dev`. Must differ from the client port.
API_PORT=3001

# Persistent data boundary (contracts §1). Relative paths resolve from the repo
# root. Nothing writes here until Phase 3.
DATA_DIR=./data

# Log verbosity: debug | info | warn | error | silent
LOG_LEVEL=info

# Used only by `npm run user:create -- --adopt-local-data`, which hands the
# existing data/<LOCAL_USER_ID>/ directory to a new account. Must be a canonical
# lowercase UUID.
LOCAL_USER_ID=0a1b2c3d-4e5f-4a6b-8c9d-0e1f2a3b4c5d

# Dev/preview only: where the Vite proxy forwards /api requests.
VITE_API_TARGET=http://localhost:3001

# ---------------------------------------------------------------------------
# Auth (Phase 4)
# ---------------------------------------------------------------------------

# closed (default) rejects self sign-up; create accounts with `npm run user:create`.
REGISTRATION_MODE=closed

# Hard session lifetime, never extended (30 days).
SESSION_ABSOLUTE_TTL_MS=2592000000

# Sliding window, refreshed on each authenticated request (7 days).
SESSION_IDLE_TTL_MS=604800000

# ---------------------------------------------------------------------------
# Streaming lifecycle (Phase 6)
# ---------------------------------------------------------------------------

# Minimum interval between generation checkpoint writes while streaming. A
# checkpoint is always written on a state transition regardless of this.
GENERATION_CHECKPOINT_MS=1000

# Events retained per generation for reconnect replay. Roughly a long reply's
# worth of chunks, so an ordinary reconnect replays exactly rather than
# resyncing, while memory per generation stays bounded.
SSE_REPLAY_EVENTS=2000

# How long a finished generation stays observable before eviction.
GENERATION_RETENTION_MS=600000

# ---------------------------------------------------------------------------
# Outbound request safety (Phase 5)
# ---------------------------------------------------------------------------

# Allow providers on 127.0.0.1, LAN, and other private ranges. Default true,
# because a local llama.cpp is the primary use case. Cloud metadata and
# link-local ranges are blocked regardless of this setting.
ALLOW_PRIVATE_PROVIDER_HOSTS=true

# Optional comma-separated hostname allowlist. When set, no other host may be
# used as a provider endpoint at all.
# PROVIDER_HOST_ALLOWLIST=llama.internal,api.example.com

# ---------------------------------------------------------------------------
# Provider (Phase 2) — a single llama.cpp `llama-server`. Multi-provider is
# Phase 5. See docs/provider-notes.md for observed behaviour of a real server.
# ---------------------------------------------------------------------------

LLAMA_BASE_URL=http://127.0.0.1:8080

# SECRET. Sent upstream only; never logged and never returned to the browser.
# Leave unset if the server runs without --api-key.
# LLAMA_API_KEY=

# Generous by design: a router-mode server swaps models on demand, and a cold
# load was measured at ~12 s before the first token.
PROVIDER_TIMEOUT_MS=120000

# Used when a model's real context length is not known. Discovering it costs a
# model load on a router-mode server, so it is never probed eagerly.
DEFAULT_CONTEXT_TOKENS=8192

# Reasoning models (gpt-oss) can spend this entire budget on reasoning and
# return no content at all. Raise it if replies come back empty.
MAX_OUTPUT_TOKENS=2048

# --- Attachments (Phase 11) -------------------------------------------------
# Per file. Enforced while the upload streams, so an oversized file is refused
# on the first byte past the limit rather than after it has all arrived.
# ATTACHMENT_MAX_BYTES=10485760
# Everything one account has stored, pending and linked alike.
# ATTACHMENT_MAX_TOTAL_BYTES_PER_USER=536870912
# How long an upload nobody sent survives before it is collected.
# ATTACHMENT_PENDING_TTL_MS=86400000
# Characters of a text attachment inlined into a prompt before truncation.
# The stored file is never altered; this only bounds what a model is sent.
# ATTACHMENT_MAX_INLINE_CHARS=100000

# --- TLS (Phase 12 / native HTTPS) ------------------------------------------
# Set BOTH to serve HTTPS directly, without a reverse proxy. Both or neither —
# setting only one stops the boot rather than serving cleartext on a port you
# now believe is encrypted. Leave unset if a proxy terminates TLS in front.
# TLS_CERT_FILE=/etc/ssl/rgfschat/fullchain.pem
# TLS_KEY_FILE=/etc/ssl/rgfschat/privkey.pem
